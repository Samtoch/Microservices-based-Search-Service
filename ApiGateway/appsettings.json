{
  "ReverseProxy": {
    "Routes": {
      "userRoute": {
        "ClusterId": "userCluster",
        "Match": { "Path": "/user/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/user" }
        ]
      },
      "searchRoute": {
        "ClusterId": "searchCluster",
        "Match": { "Path": "/search/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/search" }
        ]
      },
      "documentsRoute": {
        "ClusterId": "documentsCluster",
        "Match": { "Path": "/documents/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/documents" }
        ]
      }
    },
    "Clusters": {
      "userCluster": {
        "Destinations": {
          "userDest": {
            "Address": "http://localhost:5166/api/user"
          }
        }
      },
      "searchCluster": {
        "Destinations": {
          "searchDest": {
            "Address": "http://localhost:5050/api/search"
          }
        }
      },
      "documentsCluster": {
        "Destinations": {
          "documentsDest": {
            "Address": "http://localhost:5050/api/documents"
          }
        }
      }
    }
  }
}